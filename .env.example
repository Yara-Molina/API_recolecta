MODELO_REPORTES_URL=http://modelo_reportes:8000
CLASIFICADOR_URL=http://clasificador_reportes:8001
# Webhook del servicio api-rutas (Node.js): se notifica POST /anomalia_creada
# cuando se crea una anomalia con coordenadas. Verificado en produccion (ver
# docs/implementacion-fix-anomalias-y-ag.md) -- api-rutas es quien llama al
# AG y notifica a los conductores por su propio WebSocket, gin-backend solo
# dispara este webhook.
ANOMALIA_CREADA_WEBHOOK_URL=https://api-rutas.practicasoftware.fun/anomalia_creada
